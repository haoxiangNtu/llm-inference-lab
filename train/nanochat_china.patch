     if not torch.cuda.is_available():
         return None
     try:
+        # Offline path: load a pre-downloaded FA3 kernel build directly from a local directory
+        # (the `kernels` hub loader needs network access to huggingface.co, which is unreachable here).
+        import os
+        local_fa3 = os.environ.get("NANOCHAT_FA3_PATH")
+        if local_fa3 and os.path.isdir(local_fa3):
+            import importlib.util, sys
+            spec = importlib.util.spec_from_file_location(
+                "flash_attn3_kernel", os.path.join(local_fa3, "__init__.py"), submodule_search_locations=[local_fa3])
+            mod = importlib.util.module_from_spec(spec)
+            sys.modules["flash_attn3_kernel"] = mod
+            spec.loader.exec_module(mod)
+            return mod.flash_attn_interface
         major, _ = torch.cuda.get_device_capability()
         # FA3 kernels are currently compiled for Hopper (sm90), Ada (sm89) and Ampere (sm80/sm86)
